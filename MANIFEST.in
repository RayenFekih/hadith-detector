include README.md CONTRIBUTING.md CHANGELOG.md LICENSE pyproject.toml
include setup.py
include src/hadith_detector/_bundle.json
recursive-include src/hadith_detector/_data *
recursive-include src/hadith_detector *.py py.typed
recursive-include tests *.py
recursive-include docs *.md
recursive-include examples *.json
# This report records final archive checksums; keep it outside the archives it describes.
exclude docs/phase7-validation.md
recursive-include tools *.py *.json
recursive-include tools/bundle-notices *.md *.txt *.csv
include uv.lock
prune data
include data/README.md
prune .github
prune .vscode
prune .cache
prune .ruff_cache
prune .mypy_cache
prune .pytest_cache
prune .venv
prune notebooks
prune others
prune logs
global-exclude *.py[cod] .gitkeep
global-exclude .env .env.*
# Keep historical evaluation reports locally; do not ship them with the feature.
exclude docs/phase*.md
exclude docs/contextual-validation.md
prune tools/evaluation
exclude tests/test_contextual_evaluation.py tests/test_phase6_jev.py
exclude tests/test_blind_annotation.py tests/test_annotation_comparison.py
exclude tests/test_evaluation_preparation.py tests/test_evaluation_finalization.py
exclude tests/test_technical_pilot.py tests/test_review_notebook.py
